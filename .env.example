##############################################################################
# Velora Living — environment variables
#
# Copy this file to `.env` for local development:
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. In production these are set
# in the Vercel dashboard under Settings → Environment Variables.
##############################################################################

# ─── Database ───────────────────────────────────────────────────────────────
# Postgres connection string. Used in production AND locally — prisma/schema.prisma
# is set to the "postgresql" provider.
#
# Where to get one:
#   Vercel   Storage -> Create Database -> Postgres, then copy the POOLED string
#   Supabase Project Settings -> Database -> Connection string -> URI,
#            use the pooling URI (port 6543) and append
#            ?pgbouncer=true&connection_limit=1
#
# Use a SEPARATE database for local development so you are not writing test
# enquiries into live data. Both providers let you create a second free project.
#
# After setting this, create the tables once with:  npm run db:push
DATABASE_URL="postgres://user:password@host:5432/velora?sslmode=require"

# ─── Email ──────────────────────────────────────────────────────────────────
# Which transport to use:
#   resend   — real delivery via Resend (needs RESEND_API_KEY below)
#   console  — nothing is sent; messages are logged and written to .mail-preview/
#
# Leave this unset to choose automatically: `resend` when RESEND_API_KEY is
# present, `console` when it isn't. That means local dev works with no setup.
# EMAIL_PROVIDER="resend"

# API key from https://resend.com/api-keys — starts with `re_`.
# Leave blank locally to keep everything in preview mode.
RESEND_API_KEY=""

# The From address on every outgoing email.
#
# You cannot send as a Gmail address through Resend — Gmail's DMARC policy will
# reject it. Two options:
#   1. Start with Resend's sandbox sender below. It works immediately, but only
#      delivers to the address that owns the Resend account. Fine for testing.
#   2. Buy a domain, verify it in Resend (Domains → Add Domain), then send as
#      something like hello@veloraliving.com. Required before real customers can
#      receive the auto-reply and welcome emails.
EMAIL_FROM="Velora Living <onboarding@resend.dev>"
# EMAIL_FROM="Velora Living <hello@veloraliving.com>"

# Where enquiry notifications are delivered — your own inbox.
OWNER_EMAIL="parikhnirmam@gmail.com"

# ─── Admin ──────────────────────────────────────────────────────────────────
# The single password for /admin. There is no user account — this is the whole
# credential, so make it long. Without it, /admin refuses every login.
ADMIN_PASSWORD="change-this-to-something-long-and-random"

# Secret used to sign the admin session cookie and unsubscribe links.
# Must be at least 16 characters, and is REQUIRED in production.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-this-too-openssl-rand-base64-32"

# ─── Site ───────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph tags,
# sitemap.xml, robots.txt and unsubscribe links.
# Locally, leave as-is. In production set it to your real domain, e.g.
#     NEXT_PUBLIC_SITE_URL="https://veloraliving.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
